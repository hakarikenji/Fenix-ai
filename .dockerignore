fenix-brain-modal
fenix-brain-space
fenix-core-lora
fenix-music
fenix-music-apk-kit
fenix-music-brain-space
fenix-video-brain-space
# fenix-video is excluded except the one package the server imports.
fenix-video/**
!fenix-video/api
!fenix-video/api/**
*.md
